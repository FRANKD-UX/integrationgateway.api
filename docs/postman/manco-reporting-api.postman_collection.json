          "name": "State Machine - Submit",
          "request": { "method": "POST", "header": [], "url": "{{base_url}}/api/manco/reports/{{reportId}}/submit" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('204 submit', () => pm.response.to.have.status(204));" ] } }]
        },
        {
          "name": "State Machine - Resubmit Rejected",
          "request": { "method": "POST", "header": [], "url": "{{base_url}}/api/manco/reports/{{reportId}}/submit" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('400 cannot resubmit', () => pm.response.to.have.status(400));" ] } }]
        },
