      "item": [
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"title\": \"Validation task\",\n  \"description\": \"Task created by Postman collection\",\n  \"priority\": \"High\",\n  \"dueDate\": \"2026-06-30\",\n  \"assignedTo\": \"{{assigned_to}}\"\n}" },
            "url": "{{base_url}}/api/manco/projects/{{projectId}}/tasks"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('201 task created', () => pm.response.to.have.status(201));", "pm.environment.set('taskId', pm.response.json().taskId);" ] } }]
        },
        {
          "name": "Task Status - InProgress",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": \"InProgress\" }" }, "url": "{{base_url}}/api/manco/projects/{{projectId}}/tasks/{{taskId}}/status" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('204 in progress', () => pm.response.to.have.status(204));" ] } }]
        },
        {
          "name": "Task Status - Done",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": \"Done\" }" }, "url": "{{base_url}}/api/manco/projects/{{projectId}}/tasks/{{taskId}}/status" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('204 done', () => pm.response.to.have.status(204));" ] } }]
        },
        {
          "name": "Get Tasks - CompletedAt Set",
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/manco/projects/{{projectId}}/tasks" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200 tasks', () => pm.response.to.have.status(200));", "const task = pm.response.json().find(t => t.taskId === pm.environment.get('taskId'));", "pm.test('Done with completedAt', () => { pm.expect(task.status).to.eql('Done'); pm.expect(task.completedAt).to.not.eql(null); });", "pm.environment.set('completedAt', task.completedAt);" ] } }]
        },
        {
          "name": "Task Status - Done Idempotent",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": \"Done\" }" }, "url": "{{base_url}}/api/manco/projects/{{projectId}}/tasks/{{taskId}}/status" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('204 second done', () => pm.response.to.have.status(204));" ] } }]
        }
      ]
    },
    {
      "name": "03 - Backlog Reasons",
      "item": [
        {
          "name": "Add Backlog Reason",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"reasonText\": \"Deferred pending steering committee decision.\" }" }, "url": "{{base_url}}/api/manco/projects/{{projectId}}/backlog-reasons" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('201 backlog reason', () => pm.response.to.have.status(201));" ] } }]
        },
        {
          "name": "Get Backlog Reasons",
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/manco/projects/{{projectId}}/backlog-reasons" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200 backlog reasons', () => pm.response.to.have.status(200));", "pm.test('at least one reason', () => pm.expect(pm.response.json().length).to.be.at.least(1));" ] } }]
        }
      ]
    },
    {
      "name": "04 - Reports",
      "item": [
        {
          "name": "State Machine - Create Draft",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"weekNumber\": 22,\n  \"year\": 2026,\n  \"summary\": \"Weekly validation summary\",\n  \"achievements\": \"Project validation started\",\n  \"blockers\": null,\n  \"plannedNextWeek\": \"Continue validation\"\n}" }, "url": "{{base_url}}/api/manco/reports" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('201 report draft', () => pm.response.to.have.status(201));", "const json = pm.response.json();", "pm.environment.set('reportId', json.reportId);", "pm.test('Draft status', () => pm.expect(json.reportStatus).to.eql('Draft'));" ] } }]
        },
        {
          "name": "State Machine - Duplicate Rejected",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"weekNumber\": 22,\n  \"year\": 2026,\n  \"summary\": \"Duplicate weekly validation summary\"\n}" }, "url": "{{base_url}}/api/manco/reports" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('409 duplicate report', () => pm.response.to.have.status(409));" ] } }]
        },
        {
          "name": "State Machine - Draft Review Rejected",
          "request": { "method": "POST", "header": [], "url": "{{base_url}}/api/manco/reports/{{reportId}}/review" },
