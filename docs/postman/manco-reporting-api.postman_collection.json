          "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/manco/reports/{{reportId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200 report detail', () => pm.response.to.have.status(200));", "const json = pm.response.json();", "pm.test('Actioned with review metadata', () => { pm.expect(json.reportStatus).to.eql('Actioned'); pm.expect(json.reviewedBy).to.not.eql(null); pm.expect(json.reviewedAt).to.not.eql(null); });" ] } }]
