          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('400 XOR neither rejected', () => pm.response.to.have.status(400));" ] } }]
        },
        {
          "name": "Resolve Comment",
          "request": { "method": "POST", "header": [], "url": "{{base_url}}/api/manco/comments/{{commentId}}/resolve" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('204 resolve', () => pm.response.to.have.status(204));" ] } }]
        },
        {
          "name": "Get Report Comments",
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/manco/comments/report/{{reportId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200 report comments', () => pm.response.to.have.status(200));", "const comment = pm.response.json().find(c => c.commentId === pm.environment.get('commentId'));", "pm.test('resolved comment visible', () => { pm.expect(comment).to.exist; pm.expect(comment.isResolved).to.eql(true); pm.expect(comment.resolvedAt).to.not.eql(null); });" ] } }]
        }
      ]
    }
  ],
  "variable": [
    { "key": "projectId", "value": "" },
    { "key": "decisionId", "value": "" }
  ]
}
